MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/rome-portfolio?appName=rome-portfolio
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (required on Vercel; local disk is used in development if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Testing: ROME <onboarding@resend.dev>
# Production: ROME <hello@your-verified-domain.com>
RESEND_FROM=ROME <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com

# Analytics (optional — pick one)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
